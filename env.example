# DialogueForge Environment Configuration

# ElevenLabs (can also be set via GUI)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Database
POSTGRES_USER=dialogueforge
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=dialogueforge
DATABASE_URL=postgresql+asyncpg://dialogueforge:changeme_in_production@postgres:5432/dialogueforge

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-this-to-a-random-secret-key
API_RATE_LIMIT=100/minute
MAX_CONCURRENT_GENERATIONS=5
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:80/api

# ── Local TTS Engines (run separately via tts-engines/docker-compose.yml) ──
# Uncomment and set URLs when running local TTS engines:
# CHATTERBOX_URL=http://host.docker.internal:4123
# ORPHEUS_URL=http://host.docker.internal:8899
# KOKORO_URL=http://host.docker.internal:8880
# XTTS_URL=http://host.docker.internal:5500
